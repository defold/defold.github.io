        {
            "description": "Sets the callback used for all LevelPlay events. Pass nil to remove it.",
            "examples": "",
            "name": "levelplay.set_callback",
            "parameters": [
                {
                    "doc": "",
                    "name": "callback",
                    "parameters": [
                        {
                            "doc": "The script instance that installed the callback.",
                            "name": "self",
                            "types": [
                                "object"
                            ]
                        },
                        {
                            "doc": "One of MSG_INIT, MSG_INTERSTITIAL, MSG_REWARDED, MSG_BANNER, or MSG_TRACKING.",
                            "name": "message_id",
                            "types": [
                                "number"
                            ]
                        },
                        {
                            "doc": "Event data. Every asynchronous SDK event contains `event`. Events from a created ad object also contain `handle`; pre-creation validation errors do not.",
                            "name": "message",
                            "parameters": [
                                {
                                    "doc": "An EVENT_* constant, or a TRACKING_STATUS_* constant for MSG_TRACKING.",
                                    "name": "event",
