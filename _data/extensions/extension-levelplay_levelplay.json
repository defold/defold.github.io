        {
            "description": "Initializes LevelPlay. Configure privacy before calling this function. Create ad objects only after EVENT_INIT_SUCCEEDED.",
            "examples": "",
            "name": "levelplay.init",
            "parameters": [
                {
                    "doc": "Application key from the LevelPlay dashboard. This is not an ad-unit ID.",
                    "name": "app_key",
                    "types": [
                        "string"
                    ]
                },
                {
                    "doc": "Stable application user ID included in the initialization request.",
                    "name": "user_id",
                    "types": [
                        "string"
                    ]
                }
            ],
            "returnvalues": [],
            "type": "FUNCTION"
        },
