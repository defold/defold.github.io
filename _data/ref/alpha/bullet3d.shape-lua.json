    "info": {
        "api_language": "Lua",
        "brief": "Bullet collision shape API",
        "description": "Borrowed shape handles identify a one-based child slot on a Defold-owned\ncollision object. They remain attached to that logical slot when its native\nshape is replaced and become invalid with their owning collision object.\nShape mutation is copy-on-write, so instances sharing a collision resource\nare not modified together. Lengths use Defold world units.",
        "description_html": "<p>Borrowed shape handles identify a one-based child slot on a Defold-owned\ncollision object. They remain attached to that logical slot when its native\nshape is replaced and become invalid with their owning collision object.\nShape mutation is copy-on-write, so instances sharing a collision resource\nare not modified together. Lengths use Defold world units.</p>",
        "file": "script_bullet3d_shape.cpp",
        "name": "bullet3d.shape",
        "namespace": "bullet3d.shape",
        "notes": [],
        "path": "engine/gamesys/src/gamesys/scripts/bullet3d/script_bullet3d_shape.cpp",
        "type": "Defold Lua"
    }
