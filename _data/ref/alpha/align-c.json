        {
            "brief": "64-bit value alignment macro",
            "description": "Round a nonnegative integer value up to an alignment boundary using 64-bit\nunsigned arithmetic, including on 32-bit targets. The result is a uint64_t.\nUse DM_ALIGN for pointer alignment.\nThe alignment must be a nonzero power of two, and the rounded value must fit\nin uint64_t. Overflow is not checked. Arguments must not have side effects.",
            "error": "",
            "examples": "Round up across the 32-bit size boundary without truncating the result:\n<div class=\"codehilite\"><pre><span></span><code><span class=\"kt\">uint64_t</span><span class=\"w\"> </span><span class=\"n\">result</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"n\">DM_ALIGN64</span><span class=\"p\">(</span><span class=\"n\">UINT32_MAX</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"mi\">16</span><span class=\"p\">);</span><span class=\"w\"> </span><span class=\"c1\">// 4294967296</span>\n</code></pre></div>",
            "language": "",
            "members": [],
            "name": "DM_ALIGN64",
            "notes": [],
            "parameters": [
                {
                    "doc": "nonnegative integer value to align",
                    "is_optional": "False",
                    "name": "x",
                    "types": [
                        "uint64_t"
                    ]
                },
                {
                    "doc": "nonzero power-of-two alignment boundary",
                    "is_optional": "False",
                    "name": "a",
                    "types": [
                        "uint64_t"
                    ]
                }
            ],
            "replaces": "",
            "returnvalues": [],
            "tparams": [],
            "type": "MACRO"
        },
