{
    "elements": [
        {
            "brief": "Add resource mount",
            "description": "Adds a resource mount to the resource system.\nAfter the mount succeeded, the resources are available to load. (i.e. no reboot required)",
            "error": "",
            "examples": "Add multiple mounts. Higher priority takes precedence.\n<div class=\"codehilite\"><pre><span></span><code><span class=\"n\">liveupdate</span><span class=\"p\">.</span><span class=\"n\">add_mount</span><span class=\"p\">(</span><span class=\"s2\">&quot;common&quot;</span><span class=\"p\">,</span> <span class=\"s2\">&quot;zip:/path/to/common_stuff.zip&quot;</span><span class=\"p\">,</span> <span class=\"mi\">10</span><span class=\"p\">,</span> <span class=\"kr\">function</span> <span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">,</span> <span class=\"n\">name</span><span class=\"p\">,</span> <span class=\"n\">uri</span><span class=\"p\">,</span> <span class=\"n\">result</span><span class=\"p\">)</span> <span class=\"kr\">end</span><span class=\"p\">)</span> <span class=\"c1\">-- base pack</span>\n<span class=\"n\">liveupdate</span><span class=\"p\">.</span><span class=\"n\">add_mount</span><span class=\"p\">(</span><span class=\"s2\">&quot;levelpack_1&quot;</span><span class=\"p\">,</span> <span class=\"s2\">&quot;zip:/path/to/levels_1_to_20.zip&quot;</span><span class=\"p\">,</span> <span class=\"mi\">20</span><span class=\"p\">,</span> <span class=\"kr\">function</span> <span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">,</span> <span class=\"n\">name</span><span class=\"p\">,</span> <span class=\"n\">uri</span><span class=\"p\">,</span> <span class=\"n\">result</span><span class=\"p\">)</span> <span class=\"kr\">end</span><span class=\"p\">)</span> <span class=\"c1\">-- level pack</span>\n<span class=\"n\">liveupdate</span><span class=\"p\">.</span><span class=\"n\">add_mount</span><span class=\"p\">(</span><span class=\"s2\">&quot;season_pack_1&quot;</span><span class=\"p\">,</span> <span class=\"s2\">&quot;zip:/path/to/easter_pack_1.zip&quot;</span><span class=\"p\">,</span> <span class=\"mi\">30</span><span class=\"p\">,</span> <span class=\"kr\">function</span> <span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">,</span> <span class=\"n\">name</span><span class=\"p\">,</span> <span class=\"n\">uri</span><span class=\"p\">,</span> <span class=\"n\">result</span><span class=\"p\">)</span> <span class=\"kr\">end</span><span class=\"p\">)</span> <span class=\"c1\">-- season pack, overriding content in the other packs</span>\n</code></pre></div>",
            "language": "",
            "members": [],
            "name": "liveupdate.add_mount",
            "notes": [
                "The request is asynchronous",
                "Mounts are active for the current session only",
                "Names cannot be '_base' or '_builtin'",
                "Priority must be >= 0"
            ],
            "parameters": [
                {
                    "doc": "Unique name of the mount",
                    "is_optional": "False",
                    "name": "name",
                    "types": [
                        "string",
                        "hash"
                    ],
                    "types_html": [
                        "<a href=\"../../../manuals/lua/#variables-and-data-types\">string</a>",
                        "<a href=\"../builtins-lua/#hash\">hash</a>"
                    ],
                    "types_table_html": [
                        "<a href=\"../../../manuals/lua/#variables-and-data-types\">string</a>",
                        "<a href=\"../builtins-lua/#hash\">hash</a>"
                    ]
                },
                {
                    "doc": "The uri of the mount, including the scheme. Currently supported schemes are 'zip' and 'archive'.",
                    "is_optional": "False",
                    "name": "uri",
                    "types": [
                        "string"
                    ],
                    "types_html": [
                        "<a href=\"../../../manuals/lua/#variables-and-data-types\">string</a>"
                    ],
                    "types_table_html": [
                        "<a href=\"../../../manuals/lua/#variables-and-data-types\">string</a>"
                    ]
                },
                {
                    "doc": "Priority of mount. Larger priority takes prescedence",
                    "is_optional": "False",
                    "name": "priority",
                    "types": [
                        "integer"
                    ],
                    "types_html": [
                        "<a href=\"../../../manuals/lua/#variables-and-data-types\">integer</a>"
                    ],
                    "types_table_html": [
                        "<a href=\"../../../manuals/lua/#variables-and-data-types\">integer</a>"
                    ]
                },
                {
                    "doc": "Callback after the asynchronous request completed\n- <code>name</code> <span class=\"type\"><a href=\"../builtins-lua/#hash\">hash</a></span> Unique name of the mount\n- <code>uri</code> <span class=\"type\"><a href=\"../../../manuals/lua/#variables-and-data-types\">string</a></span> The uri of the mount\n- <code>result</code> <span class=\"type\"><a href=\"#liveupdate.LIVEUPDATE\">liveupdate.LIVEUPDATE</a></span> The result of the request",
                    "is_optional": "False",
                    "name": "callback",
                    "types": [
                        "fun(self:script_instance, name:hash, uri:string, result:liveupdate.LIVEUPDATE)"
                    ],
                    "types_html": [
                        "fun(self:<a href=\"../builtins-lua/#script_instance\">script_instance</a>, name:<a href=\"../builtins-lua/#hash\">hash</a>, uri:<a href=\"../../../manuals/lua/#variables-and-data-types\">string</a>, result:<a href=\"#liveupdate.LIVEUPDATE\">liveupdate.LIVEUPDATE</a>)"
                    ],
                    "types_table_html": [
                        "<a href=\"../../../manuals/lua/#variables-and-data-types\">function</a>(\n\tself:<a href=\"../builtins-lua/#script_instance\">script_instance</a>,\n\tname:<a href=\"../builtins-lua/#hash\">hash</a>,\n\turi:<a href=\"../../../manuals/lua/#variables-and-data-types\">string</a>,\n\tresult:<a href=\"#liveupdate.LIVEUPDATE\">liveupdate.LIVEUPDATE</a>)"
                    ]
                }
            ],
            "replaces": "",
