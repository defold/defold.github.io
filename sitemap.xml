---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	{%- assign sitemap_pages = site.posts | concat: site.html_pages -%}
	{%- for sitemap_page in sitemap_pages -%}
	{%- include search_engine_metadata.html page=sitemap_page -%}
	{%- unless search_engine_noindex or sitemap_page.published == false or sitemap_page.sitemap == false -%}
	{%- if canonical_url == search_page_url -%}
	<url>
		<loc>{{ canonical_url | xml_escape }}</loc>
		{%- if sitemap_page.last_modified_at -%}
		<lastmod>{{ sitemap_page.last_modified_at | date_to_xmlschema }}</lastmod>
		{%- endif -%}
	</url>
	{%- endif -%}
	{%- endunless -%}
	{%- endfor -%}
</urlset>
